# Local development environment. Copy to apps/web/.env.local and apps/worker/.env (or export).
# Never commit real values. Production values are generated by deploy/install.sh.

NODE_ENV=development
APP_URL=http://localhost:3000
DEFAULT_LOCALE=en

# docker compose -f deploy/docker-compose.dev.yml up -d  (Postgres + Redis for development)
DATABASE_URL=postgresql://rentagent:rentagent@localhost:5432/rentagent
REDIS_URL=redis://:rentagent@localhost:6379

# 32 random bytes, base64:  openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Comma-separated previous keys, only during key rotation.
APP_ENCRYPTION_KEYS_PREVIOUS=

# At least 32 characters:  openssl rand -base64 36
SETUP_TOKEN=

FILES_DIR=./data/files
LOG_LEVEL=debug
NEXT_TELEMETRY_DISABLED=1

# Optional license. Can also be entered under Admin › License (that value wins).
LICENSE_KEY=
# Optional vendor license server for a daily check (sends only license id, domain, version).
LICENSE_SERVER_URL=

# Test only: point the payment SDKs at local mock servers. Never set these in production.
# STRIPE_API_BASE=http://127.0.0.1:4012
# PAYPAL_API_BASE=http://127.0.0.1:4013
