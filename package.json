{
  "name": "rentagent",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted, white-label AI agent rental platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @rentagent/db generate",
    "db:migrate": "pnpm --filter @rentagent/db migrate:dev",
    "db:deploy": "pnpm --filter @rentagent/db migrate:deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript-eslint": "8.72.1"
  }
}
