# Automatic HTTPS via Let's Encrypt for APP_DOMAIN.
# Security headers are set by the application; Caddy only terminates TLS and proxies.
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	# Upload limit; individual endpoints enforce stricter limits.
	request_body {
		max_size 50MB
	}

	header -Server

	# Discovers every web instance (WEB_REPLICAS) through Docker's DNS.
	reverse_proxy {
		dynamic a web 3000 {
			refresh 5s
		}
		lb_policy least_conn
		lb_try_duration 5s
		health_uri /api/health
		health_interval 10s
	}
}
