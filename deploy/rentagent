#!/usr/bin/env bash
# RentAgent management CLI. Installed to /usr/local/bin/rentagent by install.sh.
set -Eeuo pipefail

RENTAGENT_HOME="${RENTAGENT_HOME:-/opt/rentagent}"
BACKUP_KEEP="${BACKUP_KEEP:-7}"

die()  { printf '\033[31m✘ %s\033[0m\n' "$*" >&2; exit 1; }
ok()   { printf '\033[32m✔\033[0m %s\n' "$*"; }
info() { printf '%s\n' "$*"; }

[[ -f "$RENTAGENT_HOME/.env" ]] || die "RentAgent is not installed in $RENTAGENT_HOME (set RENTAGENT_HOME to override)."
cd "$RENTAGENT_HOME"

env_get() { grep -E "^$1=" .env | tail -1 | cut -d= -f2-; }
env_set() { # env_set KEY VALUE  (VALUE must not contain '|')
  if grep -qE "^$1=" .env; then sed -i "s|^$1=.*|$1=$2|" .env; else printf '%s=%s\n' "$1" "$2" >> .env; fi
}
dc() { docker compose "$@"; }

wait_healthy() { # wait_healthy [timeout_seconds] — every web instance (WEB_REPLICAS) must be healthy
  local timeout=${1:-180} waited=0 ids total healthy
  while (( waited < timeout )); do
    ids=$(dc ps -q web 2>/dev/null || true)
    if [[ -n "$ids" ]]; then
      total=$(wc -l <<< "$ids")
      # shellcheck disable=SC2086 # one argument per container id
      healthy=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' $ids 2>/dev/null | grep -c '^healthy$' || true)
      (( healthy == total )) && { ok "Web service is healthy ($total instance(s))"; return 0; }
    fi
    sleep 5; waited=$((waited + 5))
  done
  return 1
}

cmd_status() {
  info "Version: $(env_get RENTAGENT_VERSION)"
  dc ps
  local id; id=$(dc ps -q web | head -1)
  [[ -n "$id" ]] && docker exec "$id" node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>r.text()).then(t=>console.log('Health:', t)).catch(e=>{console.error('Health check failed:', e.message);process.exit(1)})"
  info ""; df -h "$RENTAGENT_HOME" | tail -1 | awk '{print "Disk: " $4 " free of " $2}'
}

cmd_backup() {
  local stamp dir user db
  stamp=$(date -u +%Y%m%d-%H%M%S)
  dir="$RENTAGENT_HOME/backups/$stamp"
  user=$(env_get POSTGRES_USER); db=$(env_get POSTGRES_DB)
  umask 077
  mkdir -p "$dir"
  info "Backing up to $dir …"
  dc exec -T postgres pg_dump -U "$user" -d "$db" --format=custom --no-owner > "$dir/database.dump"
  dc exec -T worker tar -C /data/files -czf - . > "$dir/files.tar.gz"
  cp .env "$dir/env.backup"
  env_get RENTAGENT_VERSION > "$dir/VERSION"
  (cd "$dir" && sha256sum database.dump files.tar.gz env.backup VERSION > SHA256SUMS)
  ok "Backup complete: $dir ($(du -sh "$dir" | cut -f1))"
  info "Contains secrets (env.backup). Copy it off this server to encrypted storage."
  # Retention: keep the newest $BACKUP_KEEP backups.
  find "$RENTAGENT_HOME/backups" -mindepth 1 -maxdepth 1 -type d | sort -r | tail -n +$((BACKUP_KEEP + 1)) | xargs -r rm -rf
  LAST_BACKUP_DIR="$dir"
}

restore_from() { # restore_from <dir>   (no prompt)
  local dir=$1 user db
  user=$(env_get POSTGRES_USER); db=$(env_get POSTGRES_DB)
  (cd "$dir" && sha256sum -c --quiet SHA256SUMS) || die "Backup checksum verification failed: $dir"
  dc stop web worker caddy
  dc exec -T postgres pg_restore -U "$user" -d "$db" --clean --if-exists --no-owner --single-transaction < "$dir/database.dump"
  dc run --rm --no-deps -T --entrypoint sh worker -c 'find /data/files -mindepth 1 -delete && tar -C /data/files -xzf -' < "$dir/files.tar.gz"
  env_set RENTAGENT_VERSION "$(cat "$dir/VERSION")"
  # Health is verified by the caller; a failing dependency must not abort the restore.
  dc up -d || true
}

cmd_restore() {
  local dir=${1:-}
  [[ -n "$dir" && -d "$dir" ]] || die "Usage: rentagent restore <backup-directory>  (see $RENTAGENT_HOME/backups)"
  read -r -p "This replaces ALL current data with the backup from $dir. Type RESTORE to continue: " answer
  [[ "$answer" == "RESTORE" ]] || die "Aborted."
  restore_from "$dir"
  wait_healthy 300 || die "Restore finished but the service is not healthy. Check: rentagent logs"
  ok "Restore complete."
}

cmd_update() {
  local target=${1:-latest} previous
  previous=$(env_get RENTAGENT_VERSION)
  info "Updating from $previous to $target"
  cmd_backup
  local backup_dir=$LAST_BACKUP_DIR
  env_set RENTAGENT_VERSION "$target"
  local fetch=(pull --quiet migrate web worker)
  # Source installs (install.sh --build) rebuild from the checked-out code instead of pulling.
  [[ "$(env_get COMPOSE_FILE)" == *build* ]] && fetch=(build migrate web worker)
  if ! dc "${fetch[@]}"; then
    env_set RENTAGENT_VERSION "$previous"
    die "Could not download version $target. Nothing was changed."
  fi
  # `up` fails when a container is unhealthy; that is handled by the rollback below.
  if dc up -d && wait_healthy 300; then
    ok "Updated to $target."
    return 0
  fi
  info "Update failed health checks — rolling back to $previous …"
  env_set RENTAGENT_VERSION "$previous"
  restore_from "$backup_dir"
  if wait_healthy 300; then
    die "Rolled back to $previous. Please send 'rentagent logs' output to support."
  fi
  die "Rollback did not become healthy. Restore manually from $backup_dir."
}

cmd_help() {
  cat <<HELP
Usage: rentagent <command>
  status              Show services, health and disk space
  logs [service]      Follow logs (web, worker, postgres, redis, caddy, migrate)
  start | stop | restart
  backup              Back up database, files and configuration
  restore <dir>       Restore a backup (replaces all data)
  update [version]    Back up, update to a version (default: latest), roll back on failure
  setup-token         Print the initial setup token
  wait-healthy [sec]  Wait until the web service is healthy
  version             Print the installed version
HELP
}

case "${1:-help}" in
  status) cmd_status ;;
  logs) shift; dc logs -f --tail=200 "$@" ;;
  start) dc up -d ;;
  stop) dc stop ;;
  restart) dc restart ;;
  backup) cmd_backup ;;
  restore) shift; cmd_restore "$@" ;;
  update) shift; cmd_update "$@" ;;
  setup-token) env_get SETUP_TOKEN ;;
  wait-healthy) shift; wait_healthy "${1:-180}" ;;
  version) env_get RENTAGENT_VERSION ;;
  help|-h|--help) cmd_help ;;
  *) cmd_help; exit 1 ;;
esac
