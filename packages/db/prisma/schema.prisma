// RentAgent database schema.
// Phase 1: installation settings, locales/translations, audit log, consent records.
// Phase 2: users, sessions, credentials, verification tokens, two-factor (Better Auth models).
// Phase 3: AI providers, keys, model registry, routing policies, usage metering.
// Phase 4: agents, versions, tools, MCP servers, runs, approvals, files and knowledge (pgvector).
// Later phases add users, providers, agents, runs and billing (see PLAN.md §7).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Key/value installation settings. Secret values are stored encrypted by the application.
model Setting {
  key       String   @id @db.VarChar(120)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.VarChar(64)

  @@map("settings")
}

enum TextDirection {
  LTR
  RTL
}

/// UI locales available in this installation (built-in and operator-added).
model Locale {
  code       String        @id @db.VarChar(35) // BCP 47 tag
  nativeName String        @map("native_name") @db.VarChar(80)
  direction  TextDirection @default(LTR)
  enabled    Boolean       @default(true)
  isDefault  Boolean       @default(false) @map("is_default")
  builtin    Boolean       @default(false)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  translations Translation[]

  @@map("locales")
}

enum TranslationStatus {
  AUTO
  REVIEWED
}

/// Operator overrides for built-in strings and full translations for added locales.
model Translation {
  locale    String            @db.VarChar(35)
  key       String            @db.VarChar(200)
  value     String
  status    TranslationStatus @default(REVIEWED)
  updatedBy String?           @map("updated_by") @db.VarChar(64)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  localeRef Locale @relation(fields: [locale], references: [code], onDelete: Cascade)

  @@id([locale, key])
  @@index([locale, status])
  @@map("translations")
}

/// Append-only security/audit trail. Never store secrets or full request bodies here.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @map("actor_id") @db.VarChar(64)
  action    String   @db.VarChar(80)
  target    String?  @db.VarChar(200)
  ipHash    String?  @map("ip_hash") @db.VarChar(64)
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

/// Proof of cookie consent choices. `anonId` is a random identifier, not linked to a user.
model ConsentRecord {
  id            BigInt   @id @default(autoincrement())
  anonId        String   @map("anon_id") @db.VarChar(64)
  policyVersion String   @map("policy_version") @db.VarChar(32)
  categories    Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([anonId])
  @@map("consent_records")
}

// ---------------------------------------------------------------- Users & auth
// Field names follow Better Auth's model contract; ids are generated by Better Auth.

enum UserRole {
  OWNER
  ADMIN
  AGENT_MANAGER
  SUPPORT
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id               String     @id @db.VarChar(64)
  name             String     @db.VarChar(100)
  email            String     @unique @db.VarChar(254)
  emailVerified    Boolean    @default(false) @map("email_verified")
  image            String?
  role             UserRole   @default(USER)
  status           UserStatus @default(ACTIVE)
  locale           String?    @db.VarChar(35)
  twoFactorEnabled Boolean?   @default(false) @map("two_factor_enabled")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]
  usage      UsageRecord[]
  runs          Run[]
  files         File[]
  conversations Conversation[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id        String   @id @db.VarChar(64)
  token     String   @unique @db.VarChar(255)
  userId    String   @map("user_id") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Credential ("credential" provider holds the password hash) and future OAuth accounts.
model Account {
  id                    String    @id @db.VarChar(64)
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(64)
  userId                String    @map("user_id") @db.VarChar(64)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

/// Short-lived tokens (email verification, password reset, 2FA challenges).
model Verification {
  id         String   @id @db.VarChar(64)
  identifier String   @db.VarChar(255)
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

/// TOTP secret and backup codes (encrypted by Better Auth).
model TwoFactor {
  id                      String    @id @db.VarChar(64)
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.VarChar(64)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("two_factors")
}

// ---------------------------------------------------------------- AI providers

enum ProviderType {
  OPENAI
  ANTHROPIC
  GOOGLE
  MISTRAL
  XAI
  DEEPSEEK
  GROQ
  TOGETHER
  FIREWORKS
  PERPLEXITY
  COHERE
  OPENROUTER
  AZURE_OPENAI
  AMAZON_BEDROCK
  OPENAI_COMPATIBLE
}

/// A configured connection to an AI vendor or OpenAI-compatible server.
model Provider {
  id        String       @id @default(uuid()) @db.Uuid
  type      ProviderType
  name      String       @db.VarChar(80)
  /// Overrides the vendor default; required for OPENAI_COMPATIBLE.
  baseUrl   String?      @map("base_url") @db.VarChar(500)
  /// Non-secret vendor settings (e.g. Azure resource name/api version, Bedrock region).
  settings  Json         @default("{}")
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  keys   ProviderKey[]
  models AiModel[]
  usage  UsageRecord[]

  @@map("ai_providers")
}

/// API credential. `secretEncrypted` is AES-256-GCM bound to "provider-key:<id>".
model ProviderKey {
  id                 String    @id @default(uuid()) @db.Uuid
  providerId         String    @map("provider_id") @db.Uuid
  label              String    @db.VarChar(80)
  secretEncrypted    String    @map("secret_encrypted")
  last4              String    @db.VarChar(8)
  enabled            Boolean   @default(true)
  /// Monthly spend cap in micro-USD (provider cost); null = unlimited.
  monthlyLimitMicros BigInt?   @map("monthly_limit_micros")
  lastUsedAt         DateTime? @map("last_used_at") @db.Timestamptz(3)
  lastErrorAt        DateTime? @map("last_error_at") @db.Timestamptz(3)
  lastErrorKind      String?   @map("last_error_kind") @db.VarChar(40)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  provider Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  usage    UsageRecord[]

  @@index([providerId])
  @@map("ai_provider_keys")
}

enum ModelKind {
  CHAT
  EMBEDDING
}

/// Model registry entry. Costs are what the provider charges (USD per 1M tokens);
/// prices are what end users are charged (installation base currency per 1M tokens).
model AiModel {
  id              String    @id @default(uuid()) @db.Uuid
  providerId      String    @map("provider_id") @db.Uuid
  modelId         String    @map("model_id") @db.VarChar(200)
  displayName     String    @map("display_name") @db.VarChar(120)
  kind            ModelKind @default(CHAT)
  /// { tools, vision, json, reasoning } booleans
  capabilities    Json      @default("{}")
  contextWindow   Int?      @map("context_window")
  /// BCP 47 language codes the operator verified; empty = not specified.
  languages       String[]  @default([])
  costInPer1M     Decimal?  @map("cost_in_per_1m") @db.Decimal(14, 6)
  costOutPer1M    Decimal?  @map("cost_out_per_1m") @db.Decimal(14, 6)
  priceInPer1M    Decimal?  @map("price_in_per_1m") @db.Decimal(14, 6)
  priceOutPer1M   Decimal?  @map("price_out_per_1m") @db.Decimal(14, 6)
  /// Visible to end users (agents may still use hidden models).
  visible         Boolean   @default(false)
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  usage    UsageRecord[]

  @@unique([providerId, modelId])
  @@map("ai_models")
}

enum RoutingStrategy {
  FIXED
  CHEAPEST
  FASTEST
}

/// Ordered fallback chain of model ids (AiModel.id) with a selection strategy.
model RoutingPolicy {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @unique @db.VarChar(80)
  strategy  RoutingStrategy @default(FIXED)
  modelIds  String[]        @map("model_ids") @db.Uuid
  isDefault Boolean         @default(false) @map("is_default")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ai_routing_policies")
}

enum UsageStatus {
  SUCCESS
  ERROR
}

/// One provider call. Never stores prompt or completion content.
model UsageRecord {
  id           BigInt      @id @default(autoincrement())
  providerId   String?     @map("provider_id") @db.Uuid
  modelId      String?     @map("model_id") @db.Uuid
  keyId        String?     @map("key_id") @db.Uuid
  userId       String?     @map("user_id") @db.VarChar(64)
  /// What triggered the call: playground, test, agent, ...
  purpose      String      @db.VarChar(40)
  /// Groups the attempts of one request (fallback chain).
  requestId    String      @map("request_id") @db.VarChar(64)
  attempt      Int         @default(1)
  status       UsageStatus
  errorKind    String?     @map("error_kind") @db.VarChar(40)
  inputTokens  Int         @default(0) @map("input_tokens")
  outputTokens Int         @default(0) @map("output_tokens")
  /// Provider cost in micro-USD.
  costMicros   BigInt      @default(0) @map("cost_micros")
  /// End-user price in micro-units of the base currency.
  priceMicros  BigInt      @default(0) @map("price_micros")
  latencyMs    Int         @default(0) @map("latency_ms")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  provider Provider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  model    AiModel?     @relation(fields: [modelId], references: [id], onDelete: SetNull)
  key      ProviderKey? @relation(fields: [keyId], references: [id], onDelete: SetNull)
  user     User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([keyId, createdAt])
  @@index([modelId, createdAt])
  @@index([requestId])
  @@map("ai_usage_records")
}

// ---------------------------------------------------------------- Agents

enum AgentStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

model Agent {
  id                 String      @id @default(uuid()) @db.Uuid
  slug               String      @unique @db.VarChar(80)
  name               String      @db.VarChar(120)
  category           String      @db.VarChar(40)
  description        String      @default("") @db.VarChar(2000)
  /// { "<locale>": { "name": "...", "description": "..." } }
  localizations      Json        @default("{}")
  status             AgentStatus @default(DRAFT)
  /// Editable configuration (validated AgentConfig JSON); published versions are immutable copies.
  draft              Json
  publishedVersionId String?     @map("published_version_id") @db.Uuid
  templateKey        String?     @map("template_key") @db.VarChar(60)
  /// Shown first in the catalog and on the home page.
  featured           Boolean     @default(false)
  /// Folded name/description in every language (see foldForSearch).
  searchText         String      @default("") @map("search_text")
  /// Semantic search vector (embedding model set by the operator); dimension varies by model.
  embedding          Unsupported("vector")?
  createdById        String?     @map("created_by_id") @db.VarChar(64)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  versions      AgentVersion[]
  runs          Run[]
  knowledge     KnowledgeSource[]
  conversations Conversation[]

  @@index([status, featured])
  @@map("agents")
}

model AgentVersion {
  id          String   @id @default(uuid()) @db.Uuid
  agentId     String   @map("agent_id") @db.Uuid
  version     Int
  config      Json
  note        String?  @db.VarChar(300)
  createdById String?  @map("created_by_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runs  Run[]

  @@unique([agentId, version])
  @@map("agent_versions")
}

/// Operator-defined HTTP tool. The host is fixed by the operator; the model only fills parameters.
model HttpTool {
  id               String   @id @default(uuid()) @db.Uuid
  /// Function name exposed to models: ^[a-z][a-z0-9_]{2,40}$
  name             String   @unique @db.VarChar(48)
  description      String   @db.VarChar(1000)
  method           String   @db.VarChar(8)
  urlTemplate      String   @map("url_template") @db.VarChar(1000)
  /// JSON Schema (object) for the parameters.
  inputSchema      Json     @map("input_schema")
  /// Encrypted JSON object of headers (may contain secrets), bound to "http-tool:<id>".
  headersEncrypted String?  @map("headers_encrypted")
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("http_tools")
}

model McpServer {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String    @db.VarChar(80)
  /// Prefix for tool names exposed to models.
  slug                String    @unique @db.VarChar(32)
  url                 String    @db.VarChar(500)
  /// Encrypted Authorization header value, bound to "mcp-server:<id>".
  authEncrypted       String?   @map("auth_encrypted")
  enabled             Boolean   @default(true)
  /// Last discovered tool list: [{ name, description, inputSchema }]
  toolCache           Json      @default("[]") @map("tool_cache")
  toolCacheUpdatedAt  DateTime? @map("tool_cache_updated_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("mcp_servers")
}

// ---------------------------------------------------------------- Runs

enum RunMode {
  PREVIEW
  LIVE
}

enum RunStatus {
  QUEUED
  RUNNING
  WAITING_APPROVAL
  SUCCEEDED
  FAILED
  CANCELED
}

model Run {
  id             String    @id @default(uuid()) @db.Uuid
  agentId        String    @map("agent_id") @db.Uuid
  agentVersionId String?   @map("agent_version_id") @db.Uuid
  /// Exact configuration used (draft previews have no version).
  config         Json
  userId         String?   @map("user_id") @db.VarChar(64)
  conversationId String?   @map("conversation_id") @db.Uuid
  /// Follow-up text typed by the user (the first turn uses the task form `input`).
  userMessage    String?   @map("user_message")
  /// End-user feedback: 1 = helpful, -1 = not helpful.
  rating         Int?      @db.SmallInt
  feedback       String?   @db.VarChar(1000)
  mode           RunMode   @default(PREVIEW)
  status         RunStatus @default(QUEUED)
  locale         String    @db.VarChar(35)
  input          Json
  /// Conversation state (model messages) so a run can resume after approval or restart.
  messages       Json      @default("[]")
  output         String?
  errorKind      String?   @map("error_kind") @db.VarChar(40)
  stepCount      Int       @default(0) @map("step_count")
  inputTokens    Int       @default(0) @map("input_tokens")
  outputTokens   Int       @default(0) @map("output_tokens")
  costMicros     BigInt    @default(0) @map("cost_micros")
  priceMicros    BigInt    @default(0) @map("price_micros")
  cancelRequested Boolean  @default(false) @map("cancel_requested")
  startedAt      DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  agent     Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  version   AgentVersion? @relation(fields: [agentVersionId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  steps        RunStep[]
  approvals    Approval[]

  @@index([conversationId, createdAt])
  @@index([agentId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@map("runs")
}

enum RunStepType {
  MODEL
  TOOL
  APPROVAL
  SYSTEM
}

/// An end-user chat with one agent; every turn is a LIVE run.
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.VarChar(64)
  agentId   String   @map("agent_id") @db.Uuid
  title     String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runs  Run[]

  @@index([userId, updatedAt])
  @@index([updatedAt])
  @@map("conversations")
}

model RunStep {
  id         BigInt      @id @default(autoincrement())
  runId      String      @map("run_id") @db.Uuid
  idx        Int
  type       RunStepType
  toolName   String?     @map("tool_name") @db.VarChar(100)
  ok         Boolean     @default(true)
  /// Truncated, display-safe summary (never secrets).
  detail     Json        @default("{}")
  costMicros BigInt      @default(0) @map("cost_micros")
  latencyMs  Int         @default(0) @map("latency_ms")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, idx])
  @@map("run_steps")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Approval {
  id          String         @id @default(uuid()) @db.Uuid
  runId       String         @map("run_id") @db.Uuid
  toolCallId  String         @map("tool_call_id") @db.VarChar(120)
  toolName    String         @map("tool_name") @db.VarChar(100)
  input       Json
  status      ApprovalStatus @default(PENDING)
  decidedById String?        @map("decided_by_id") @db.VarChar(64)
  decidedAt   DateTime?      @map("decided_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, toolCallId])
  @@index([status])
  @@map("approvals")
}

// ---------------------------------------------------------------- Files & knowledge

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
  SKIPPED
}

model File {
  id           String     @id @default(uuid()) @db.Uuid
  ownerId      String?    @map("owner_id") @db.VarChar(64)
  originalName String     @map("original_name") @db.VarChar(255)
  mime         String     @db.VarChar(100)
  size         Int
  sha256       String     @db.VarChar(64)
  scanStatus   ScanStatus @default(PENDING) @map("scan_status")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  owner     User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  knowledge KnowledgeSource[]

  @@map("files")
}

enum KnowledgeStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model KnowledgeSource {
  id               String          @id @default(uuid()) @db.Uuid
  agentId          String          @map("agent_id") @db.Uuid
  fileId           String          @map("file_id") @db.Uuid
  status           KnowledgeStatus @default(PENDING)
  error            String?         @db.VarChar(80)
  chunkCount       Int             @default(0) @map("chunk_count")
  embeddingModelId String?         @map("embedding_model_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  agent  Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  file   File    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  chunks Chunk[]

  @@index([agentId])
  @@map("knowledge_sources")
}

/// Text chunk with an embedding. Written and searched with raw SQL (pgvector).
model Chunk {
  id               BigInt                 @id @default(autoincrement())
  sourceId         String                 @map("source_id") @db.Uuid
  agentId          String                 @map("agent_id") @db.Uuid
  idx              Int
  content          String
  embedding        Unsupported("vector")?
  embeddingModelId String                 @map("embedding_model_id") @db.Uuid

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([agentId, embeddingModelId])
  @@map("chunks")
}
