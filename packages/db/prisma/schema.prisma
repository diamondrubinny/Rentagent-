// RentAgent database schema.
// Phase 1: installation settings, locales/translations, audit log, consent records.
// Phase 2: users, sessions, credentials, verification tokens, two-factor (Better Auth models).
// Phase 3: AI providers, keys, model registry, routing policies, usage metering.
// Later phases add users, providers, agents, runs and billing (see PLAN.md §7).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Key/value installation settings. Secret values are stored encrypted by the application.
model Setting {
  key       String   @id @db.VarChar(120)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.VarChar(64)

  @@map("settings")
}

enum TextDirection {
  LTR
  RTL
}

/// UI locales available in this installation (built-in and operator-added).
model Locale {
  code       String        @id @db.VarChar(35) // BCP 47 tag
  nativeName String        @map("native_name") @db.VarChar(80)
  direction  TextDirection @default(LTR)
  enabled    Boolean       @default(true)
  isDefault  Boolean       @default(false) @map("is_default")
  builtin    Boolean       @default(false)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  translations Translation[]

  @@map("locales")
}

enum TranslationStatus {
  AUTO
  REVIEWED
}

/// Operator overrides for built-in strings and full translations for added locales.
model Translation {
  locale    String            @db.VarChar(35)
  key       String            @db.VarChar(200)
  value     String
  status    TranslationStatus @default(REVIEWED)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  localeRef Locale @relation(fields: [locale], references: [code], onDelete: Cascade)

  @@id([locale, key])
  @@map("translations")
}

/// Append-only security/audit trail. Never store secrets or full request bodies here.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @map("actor_id") @db.VarChar(64)
  action    String   @db.VarChar(80)
  target    String?  @db.VarChar(200)
  ipHash    String?  @map("ip_hash") @db.VarChar(64)
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

/// Proof of cookie consent choices. `anonId` is a random identifier, not linked to a user.
model ConsentRecord {
  id            BigInt   @id @default(autoincrement())
  anonId        String   @map("anon_id") @db.VarChar(64)
  policyVersion String   @map("policy_version") @db.VarChar(32)
  categories    Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([anonId])
  @@map("consent_records")
}

// ---------------------------------------------------------------- Users & auth
// Field names follow Better Auth's model contract; ids are generated by Better Auth.

enum UserRole {
  OWNER
  ADMIN
  AGENT_MANAGER
  SUPPORT
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id               String     @id @db.VarChar(64)
  name             String     @db.VarChar(100)
  email            String     @unique @db.VarChar(254)
  emailVerified    Boolean    @default(false) @map("email_verified")
  image            String?
  role             UserRole   @default(USER)
  status           UserStatus @default(ACTIVE)
  locale           String?    @db.VarChar(35)
  twoFactorEnabled Boolean?   @default(false) @map("two_factor_enabled")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]
  usage      UsageRecord[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id        String   @id @db.VarChar(64)
  token     String   @unique @db.VarChar(255)
  userId    String   @map("user_id") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Credential ("credential" provider holds the password hash) and future OAuth accounts.
model Account {
  id                    String    @id @db.VarChar(64)
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(64)
  userId                String    @map("user_id") @db.VarChar(64)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

/// Short-lived tokens (email verification, password reset, 2FA challenges).
model Verification {
  id         String   @id @db.VarChar(64)
  identifier String   @db.VarChar(255)
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

/// TOTP secret and backup codes (encrypted by Better Auth).
model TwoFactor {
  id                      String    @id @db.VarChar(64)
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.VarChar(64)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("two_factors")
}

// ---------------------------------------------------------------- AI providers

enum ProviderType {
  OPENAI
  ANTHROPIC
  GOOGLE
  MISTRAL
  XAI
  DEEPSEEK
  GROQ
  TOGETHER
  FIREWORKS
  PERPLEXITY
  COHERE
  OPENROUTER
  AZURE_OPENAI
  AMAZON_BEDROCK
  OPENAI_COMPATIBLE
}

/// A configured connection to an AI vendor or OpenAI-compatible server.
model Provider {
  id        String       @id @default(uuid()) @db.Uuid
  type      ProviderType
  name      String       @db.VarChar(80)
  /// Overrides the vendor default; required for OPENAI_COMPATIBLE.
  baseUrl   String?      @map("base_url") @db.VarChar(500)
  /// Non-secret vendor settings (e.g. Azure resource name/api version, Bedrock region).
  settings  Json         @default("{}")
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  keys   ProviderKey[]
  models AiModel[]
  usage  UsageRecord[]

  @@map("ai_providers")
}

/// API credential. `secretEncrypted` is AES-256-GCM bound to "provider-key:<id>".
model ProviderKey {
  id                 String    @id @default(uuid()) @db.Uuid
  providerId         String    @map("provider_id") @db.Uuid
  label              String    @db.VarChar(80)
  secretEncrypted    String    @map("secret_encrypted")
  last4              String    @db.VarChar(8)
  enabled            Boolean   @default(true)
  /// Monthly spend cap in micro-USD (provider cost); null = unlimited.
  monthlyLimitMicros BigInt?   @map("monthly_limit_micros")
  lastUsedAt         DateTime? @map("last_used_at") @db.Timestamptz(3)
  lastErrorAt        DateTime? @map("last_error_at") @db.Timestamptz(3)
  lastErrorKind      String?   @map("last_error_kind") @db.VarChar(40)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  provider Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  usage    UsageRecord[]

  @@index([providerId])
  @@map("ai_provider_keys")
}

enum ModelKind {
  CHAT
  EMBEDDING
}

/// Model registry entry. Costs are what the provider charges (USD per 1M tokens);
/// prices are what end users are charged (installation base currency per 1M tokens).
model AiModel {
  id              String    @id @default(uuid()) @db.Uuid
  providerId      String    @map("provider_id") @db.Uuid
  modelId         String    @map("model_id") @db.VarChar(200)
  displayName     String    @map("display_name") @db.VarChar(120)
  kind            ModelKind @default(CHAT)
  /// { tools, vision, json, reasoning } booleans
  capabilities    Json      @default("{}")
  contextWindow   Int?      @map("context_window")
  /// BCP 47 language codes the operator verified; empty = not specified.
  languages       String[]  @default([])
  costInPer1M     Decimal?  @map("cost_in_per_1m") @db.Decimal(14, 6)
  costOutPer1M    Decimal?  @map("cost_out_per_1m") @db.Decimal(14, 6)
  priceInPer1M    Decimal?  @map("price_in_per_1m") @db.Decimal(14, 6)
  priceOutPer1M   Decimal?  @map("price_out_per_1m") @db.Decimal(14, 6)
  /// Visible to end users (agents may still use hidden models).
  visible         Boolean   @default(false)
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  usage    UsageRecord[]

  @@unique([providerId, modelId])
  @@map("ai_models")
}

enum RoutingStrategy {
  FIXED
  CHEAPEST
  FASTEST
}

/// Ordered fallback chain of model ids (AiModel.id) with a selection strategy.
model RoutingPolicy {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @unique @db.VarChar(80)
  strategy  RoutingStrategy @default(FIXED)
  modelIds  String[]        @map("model_ids") @db.Uuid
  isDefault Boolean         @default(false) @map("is_default")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ai_routing_policies")
}

enum UsageStatus {
  SUCCESS
  ERROR
}

/// One provider call. Never stores prompt or completion content.
model UsageRecord {
  id           BigInt      @id @default(autoincrement())
  providerId   String?     @map("provider_id") @db.Uuid
  modelId      String?     @map("model_id") @db.Uuid
  keyId        String?     @map("key_id") @db.Uuid
  userId       String?     @map("user_id") @db.VarChar(64)
  /// What triggered the call: playground, test, agent, ...
  purpose      String      @db.VarChar(40)
  /// Groups the attempts of one request (fallback chain).
  requestId    String      @map("request_id") @db.VarChar(64)
  attempt      Int         @default(1)
  status       UsageStatus
  errorKind    String?     @map("error_kind") @db.VarChar(40)
  inputTokens  Int         @default(0) @map("input_tokens")
  outputTokens Int         @default(0) @map("output_tokens")
  /// Provider cost in micro-USD.
  costMicros   BigInt      @default(0) @map("cost_micros")
  /// End-user price in micro-units of the base currency.
  priceMicros  BigInt      @default(0) @map("price_micros")
  latencyMs    Int         @default(0) @map("latency_ms")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  provider Provider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  model    AiModel?     @relation(fields: [modelId], references: [id], onDelete: SetNull)
  key      ProviderKey? @relation(fields: [keyId], references: [id], onDelete: SetNull)
  user     User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([keyId, createdAt])
  @@index([modelId, createdAt])
  @@index([requestId])
  @@map("ai_usage_records")
}
